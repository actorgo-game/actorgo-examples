{
  "debug": true,
  "cluster": {
    "discovery": {
      "mode": "nats",
      "@mode": "mode=default,从profile-{x}.json读取node节点的配置数据",
      "@mode": "mode=nats,通过nats->master_node_id获取已注册的节点",
      "@mode": "mode=etcd,通过etcd同步已注册节点"
    },
    "nats": {
      "master_node_id": "262145",
      "address": "nats://127.0.0.1:4222",
      "reconnect_delay": 1,
      "max_reconnects": 0,
      "request_timeout": 2,
      "user": "actorgo",
      "password": "actorgo2026"
    }
  },
  "node": {
    "1": [
      {
        "address": ":10800",
        "__settings__": {
          "ref_logger": "master_log"
        },
        "enabled": true
      }
    ],
    "5": [
      {
        "node_id": "1310721",
        "address": ":10010",
        "__settings__": {
          "maintain_state": 2,
          "db_id_list" : {
            "game_db_id": "game_db_1"
          },
          "ref_logger": "game_log"
        },
        "enabled": true
      },
      {
        "node_id": "1310722",
        "address": ":10020",
        "__settings__": {
          "maintain_state": 2,
          "db_id_list" : {
            "game_db_id": "game_db_1"
          },
          "ref_logger": "game_log"
        },
        "enabled": true
      }
    ]
  },
  "logger": {
    "game_log": {
      "level": "debug",
      "enable_write_file": false,
      "enable_console": true,
      "file_link_path": "logs/game.log",
      "file_path_format": "logs/game_%Y%m%d%H%M.log"
    },
    "master_log": {
      "level": "debug",
      "enable_write_file": false,
      "enable_console": true,
      "file_link_path": "logs/master_log.log",
      "file_path_format": "logs/master_log_%Y%m%d%H%M.log"
    }
  }
}
